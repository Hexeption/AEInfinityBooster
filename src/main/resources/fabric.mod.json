{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": ["${authors}"],
  "contact": {
    "sources": "https://github.com/Hexeption/AEInfinityBooster",
    "issues": "https://github.com/Hexeption/AEInfinityBooster/issues"
  },
  "license": "${license}",
  "icon": "assets/${id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["${group}.AEInfinityBooster"],
    "modmenu": ["${group}.config.ModMenuIntegration"],
    "fabric-gametest": ["${group}.gametest.CardGameTests"]
  },
  "mixins": ["${id}.mixins.json"],
  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-api": "*",
    "minecraft": "${minecraftVersion}",
    "ae2": ">=15.4.0",
    "cloth-config": ">=11.1.0"
  }
}
